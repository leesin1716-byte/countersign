{
  "name": "countersign",
  "version": "0.1.0",
  "private": true,
  "description": "An AI back-office agent for PayPal sellers: it drafts refunds, invoices and subscription changes from customer messages, and nothing moves money until a deterministic policy and the seller countersign it.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:sandbox": "playwright test --config playwright.sandbox.config.ts",
    "typecheck": "tsc --noEmit",
    "probe:sandbox": "node scripts/sandbox-probe.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
