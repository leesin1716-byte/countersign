# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app must belong to a US sandbox business account with card payments and Invoicing enabled (see README).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Anthropic API key for live Claude Haiku 4.5 calls on messages written in the demo.
# Leave empty to run on the recorded runs + rules fallback.
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# PAYPAL_MODE=mock            # force the in-memory PayPal simulator
# AI_MODE=mock                # never call the model
# LIVE_AI_PER_VISITOR_DAILY=4
# LIVE_AI_GLOBAL_DAILY=25
# LIVE_AI_TOTAL_LIMIT=400
# RESETS_PER_VISITOR_DAILY=15
# DATA_DIR=./data

# Hosted on Vercel: connect a private Blob store to the project (adds BLOB_READ_WRITE_TOKEN).
# When set, workspaces and rate-limit counters live in Blob instead of local files.
# BLOB_READ_WRITE_TOKEN=
